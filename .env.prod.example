# Copy to `.env` at the REPO ROOT: compose reads it automatically for ${...}.
# Used by `docker compose -f docker-compose.yml -f docker-compose.prod.yml
# up -d --build`. Every variable here is required; compose fails fast naming
# any that are missing, instead of booting a misconfigured stack.

# Signs the session tokens issued by email/password sign-in. Generate with
# `openssl rand -hex 32` and keep it secret: anyone holding it can mint a
# session for any account, including admin. Rotating it signs everyone out.
AUTH_SECRET=

# Boot without a Firebase service account. Set while Firebase does not exist
# yet: email/password sign-in works, Firebase code paths fail closed. Unset
# it (or to false) the day the service account is mounted.
ALLOW_NO_FIREBASE=true

# Seeded admin account for the local path. Must be a real domain (not .test/
# .localhost) because POST /auth/login validates the address with email-validator.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your-secure-password

# Payments (Razorpay dashboard -> Settings -> API keys, and Webhooks for the
# webhook secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Exact browser origin(s), comma-separated, no trailing slash.
# Example: CORS_ORIGINS=https://edee.example.com
CORS_ORIGINS=

# Public API base URL. Baked into the frontend at BUILD time, so changing it
# later means rebuilding the frontend image.
# Example: NEXT_PUBLIC_API_URL=https://api.edee.example.com
NEXT_PUBLIC_API_URL=

# Firebase web config (Firebase console -> Project settings -> Your apps).
# Publishable keys; access is enforced by the backend verifying ID tokens.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
