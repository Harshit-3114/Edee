# Host port 5433: the Docker Postgres is published there to avoid colliding
# with any locally-installed PostgreSQL already on 5432.
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5433/college_platform

# Path to the Firebase Admin service account JSON. This file is a master key
# for the whole auth project: it can mint tokens for any user and grant any
# role. It is gitignored; keep it that way.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Comma-separated browser origins allowed to call this API.
# Never "*": the API sends credentials, and a wildcard origin with credentials
# lets any site a signed-in student visits read their data.
CORS_ORIGINS=http://localhost:3000

# development | test | staging | production
# Anything other than development turns off SQL echo (which logs names, emails
# and phone numbers), and production also hides /docs and /openapi.json.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR. INFO logs one line per request plus
# signups, orders, payments and role changes. Health checks log at DEBUG.
LOG_LEVEL=INFO

# Dev mode override: 1 forces dev mode on (dev: tokens accepted) even with
# Firebase keys; 0 forces it off even without them. Leave unset to
# auto-detect (dev mode when no service account is configured).
# Local development only: staging and production refuse to boot with it set.
# DEV_MODE=1

# Public site origin, for absolute links inside emails.
PUBLIC_URL=http://localhost:3000

# Outbound email (transactional: decisions, receipts, invites, alerts).
# Leave SMTP_HOST empty to disable: sends become log lines, which is what
# local development wants. Production needs a real relay.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Edee Apply <no-reply@edeeapply.in>
# SMTP_STARTTLS=true
# Platform inbox for operational alerts (contact-form arrivals).
# ADMIN_EMAIL=ops@example.com
